{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://op5.local/schemas/ocr_result.json",
  "title": "OCRResult",
  "description": "Output of an OCR adapter after running on a scanned PDF.",
  "type": "object",
  "required": [
    "case_id",
    "ocr_provider",
    "ocr_version",
    "page_count",
    "text_blocks",
    "tables"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Synthetic case identifier (e.g. contract_synth-ctr-001)."
    },
    "ocr_provider": {
      "type": "string",
      "enum": ["paddleocr", "tesseract", "easyocr"]
    },
    "ocr_version": {
      "type": "string",
      "description": "Provider library version string."
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "text_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "bbox", "text", "confidence"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x0, y0, x1, y1] in pixels."
          },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "bbox", "cells"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["row", "col", "text", "bbox"],
              "properties": {
                "row": { "type": "integer", "minimum": 0 },
                "col": { "type": "integer", "minimum": 0 },
                "row_span": { "type": "integer", "minimum": 1, "default": 1 },
                "col_span": { "type": "integer", "minimum": 1, "default": 1 },
                "text": { "type": "string" },
                "bbox": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    },
    "latency_ms": { "type": "number", "minimum": 0 },
    "error": { "type": "string" }
  }
}
