{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://op5.local/schemas/llm_response.json",
  "title": "LLMResponse",
  "description": "Standardized envelope returned by any LLM client.",
  "type": "object",
  "required": [
    "content",
    "usage",
    "latency_ms",
    "cost_usd",
    "deployment_id",
    "cache_status",
    "pricing_effective_date"
  ],
  "properties": {
    "content": { "type": "string" },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "latency_ms": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "deployment_id": {
      "type": "string",
      "description": "e.g. gemini-3.5-flash-lite or gemini-3.1-pro"
    },
    "cache_status": {
      "type": "string",
      "enum": ["hit", "miss", "bypass", "error"]
    },
    "pricing_effective_date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD of the price schedule used."
    },
    "error": { "type": "string" }
  }
}
