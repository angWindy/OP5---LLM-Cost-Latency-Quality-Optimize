# ── Google Gemini ────────────────────────────────────────────────────────────
# Required: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: override default model (gemini-3.5-flash-lite)
# OP5_GEMINI_MODEL=gemini-3.5-flash-lite

# ── HuggingFace (optional, for gated datasets) ───────────────────────────────
# Required only if using datasets that need authentication (e.g. LongBench-v2)
# HF_TOKEN=

# ── LLM-as-Judge (optional overrides) ────────────────────────────────────────
# OP5_JUDGE_MODEL=gemini-3.5-flash-lite
# OP5_JUDGE_TEMPERATURE=0.0
