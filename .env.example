# ── NVIDIA NIM ───────────────────────────────────────────────────────────────
# LLM-as-Judge primary: nvidia/nemotron-3-ultra-550b-a55b
# Get key: https://org.ngc.nvidia.com/setup/personal-keys
# Profile: src/op5/llm/profiles/nim.yaml
NVIDIA_API_KEY=

# ── Google Gemini ──────────────────────────────────────────────────────────────
# LLM-as-Judge fallback: Google AI Studio
# Get key: https://aistudio.google.com/apikey
# Profile: src/op5/llm/profiles/gemini.yaml
GOOGLE_API_KEY=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# LLM-as-Judge fallback: openrouter.ai free tier
# Get key: https://openrouter.ai/keys
# Profile: src/op5/llm/profiles/openrouter.yaml
OPENROUTER_API_KEY=

# ── LLM-as-Judge Profile Routing ──────────────────────────────────────────────
# See: src/op5/llm/profiles/
# Default chain: nim -> openrouter -> gemini
# To override: edit src/op5/llm/profiles/config.yaml
# OP5_JUDGE_TEMPERATURE=0.1

# ── HuggingFace (optional, for RAG embedding model) ──────────────────────────
# The Phase-03 MultilingualEmbedder pulls `intfloat/multilingual-e5-small` from
# HuggingFace Hub. Without a token the Hub allows anonymous reads but warns
# about rate limits. A free token (https://huggingface.co/settings/tokens)
# silences the warning and avoids 429s on the first index of a large corpus.
# Leave blank to use the anonymous fallback (works fine for the 15-doc SYNTH corpus).
# HF_TOKEN=

# ── OP5 Live UI wiring ───────────────────────────────────────────────────────
# When the FastAPI service is running on a non-default host/port, point the
# Streamlit UI at it via OP5_API_URL (defaults to http://localhost:8000).
# OP5_API_URL=http://localhost:8000
