# Phase 03 Docker storage - environment variables
# Copy to .env and adjust if needed. Defaults are DEV-ONLY.

# ChromaDB (vector store for RAG)
CHROMA_PORT=8000

# Postgres (metadata + audit log)
POSTGRES_PORT=5432
POSTGRES_USER=op5
POSTGRES_PASSWORD=op5
POSTGRES_DB=op5

# localstack S3 (S3-compatible object storage; replaces MinIO which is blocked here)
S3_PORT=4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=op5
AWS_SECRET_ACCESS_KEY=op5

# Redis (cache)
REDIS_PORT=6379

# Storage backend selector (docker | inprocess)
# docker: connect to localhost services above
# inprocess: use Chroma PersistentClient + SQLite + local FS + dict (no Docker)
STORAGE_BACKEND=docker
